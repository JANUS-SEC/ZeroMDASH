{
  "claude_binary": "claude",
  "claude_settings": "~/.claude/settings.ark-proxy.json",
  "input_csv": "research/vulnerability_researchers_top100_v2.csv",
  "output_dir": "research/people",
  "comparison_dir": "research/analysis",
  "max_concurrency": 3,
  "max_people_concurrency": 3,
  "max_turns": 18,
  "timeout_seconds": 1800,
  "max_agent_attempts": 2,
  "max_resume_attempts": 1,
  "max_editorial_revisions": 3,
  "retry_backoff_seconds": 2,
  "allowed_tools": ["WebSearch", "WebFetch", "Read"],
  "local_seed_root": "zeromdash/presets/skills"
}
