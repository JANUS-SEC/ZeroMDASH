{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["person", "edits"],
  "properties": {
    "_run": {"type": "object"},
    "person": {"type": "string"},
    "edits": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "before", "after"],
        "properties": {
          "path": {"type": "string", "pattern": "^/"},
          "before": {"type": "string"},
          "after": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
