{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["person", "expertise", "stages", "mechanisms", "tensions", "transferable_practices", "non_transferable_conditions", "open_questions"],
  "properties": {
    "_run": {"type": "object"},
    "person": {"type": "string"},
    "expertise": {"type": "array", "items": {"type": "string"}},
    "stages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["period", "stage", "capability_change", "evidence_ids", "confidence"],
        "properties": {
          "period": {"type": "string"},
          "stage": {"type": "string"},
          "capability_change": {"type": "string"},
          "evidence_ids": {"type": "array", "items": {"type": "string"}},
          "confidence": {"enum": ["high", "medium", "low"]}
        },
        "additionalProperties": false
      }
    },
    "mechanisms": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "starting_conditions", "repeated_practice", "feedback", "intermediate_capability", "observed_outcomes", "evidence_ids", "validation_tests", "confidence", "alternative_explanation"],
        "properties": {
          "name": {"type": "string"},
          "starting_conditions": {"type": "string"},
          "repeated_practice": {"type": "string"},
          "feedback": {"type": "string"},
          "intermediate_capability": {"type": "string"},
          "observed_outcomes": {"type": "array", "items": {"type": "string"}},
          "evidence_ids": {"type": "array", "items": {"type": "string"}},
          "validation_tests": {"type": "array", "items": {"enum": ["repeated", "generative", "distinctive"]}},
          "confidence": {"enum": ["high", "medium", "low"]},
          "alternative_explanation": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "tensions": {"type": "array", "items": {"type": "string"}},
    "transferable_practices": {"type": "array", "items": {"type": "string"}},
    "non_transferable_conditions": {"type": "array", "items": {"type": "string"}},
    "open_questions": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
