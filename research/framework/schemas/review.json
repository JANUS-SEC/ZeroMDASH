{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["person", "verdict", "score", "scores", "critical_issues", "unsupported_claims", "biases", "required_revisions", "editorial_revisions"],
  "properties": {
    "_run": {"type": "object"},
    "person": {"type": "string"},
    "verdict": {"enum": ["pass", "revise"]},
    "score": {"type": "integer", "minimum": 0, "maximum": 100},
    "scores": {
      "type": "object",
      "required": ["traceability", "causal_restraint", "timeline", "alternatives", "domain_explanatory_power", "transfer_boundaries"],
      "properties": {
        "traceability": {"type": "integer", "minimum": 0, "maximum": 25},
        "causal_restraint": {"type": "integer", "minimum": 0, "maximum": 25},
        "timeline": {"type": "integer", "minimum": 0, "maximum": 15},
        "alternatives": {"type": "integer", "minimum": 0, "maximum": 15},
        "domain_explanatory_power": {"type": "integer", "minimum": 0, "maximum": 10},
        "transfer_boundaries": {"type": "integer", "minimum": 0, "maximum": 10}
      },
      "additionalProperties": false
    },
    "critical_issues": {"type": "array", "items": {"type": "string"}},
    "unsupported_claims": {"type": "array", "items": {"type": "string"}},
    "biases": {"type": "array", "items": {"type": "string"}},
    "required_revisions": {"type": "array", "items": {"type": "string"}},
    "editorial_revisions": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
