{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "zeromdash://contracts/finding.schema.json",
  "title": "Finding",
  "description": "Final per-subtask record persisted by finalize_subtask and merged into the parent state buckets. Mirrors zeromdash.state.Finding.",
  "type": "object",
  "required": ["kind", "subtask_id", "title"],
  "additionalProperties": true,
  "properties": {
    "kind": {
      "type": "string",
      "enum": ["spec", "vuln", "patch_miss", "feature"]
    },
    "subtask_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "detail": {
      "type": "string"
    },
    "evidence": {
      "type": "object",
      "additionalProperties": true
    },
    "review": {
      "$ref": "review.schema.json"
    },
    "severity": {
      "type": "string",
      "enum": ["low", "medium", "high", "critical", ""]
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "iterations": {
      "type": "integer",
      "minimum": 0
    },
    "selected_skills": {
      "type": "array",
      "items": { "type": "string" }
    },
    "scope_relation": {
      "type": "string"
    },
    "patch_status": {
      "type": "string",
      "enum": ["not_applied", "bypass", "incomplete", "applied", ""],
      "description": "Structured patch-audit outcome propagated from investigation/review; empty for non-patch findings."
    },
    "scope_verdict": {
      "type": "string"
    },
    "gate_decision": {
      "type": "string"
    },
    "diff_evidence": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
