{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "zeromdash://contracts/gather-chain-investigation.schema.json",
  "title": "Gather chain investigation",
  "type": "object",
  "required": ["title", "detail", "ordered_unit_ids", "bindings", "binding_claims", "attack_path", "global_constraints", "evidence", "direct_security_impact", "cvss4_vector", "confidence", "closure_facts"],
  "additionalProperties": true,
  "properties": {
    "title": { "type": "string", "minLength": 1 },
    "detail": { "type": "string", "minLength": 1 },
    "ordered_unit_ids": { "type": "array", "minItems": 2, "items": { "type": "string", "minLength": 1 } },
    "bindings": { "type": "array", "minItems": 1, "items": { "type": "object" } },
    "binding_claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["edge_id", "provider_unit_id", "consumer_unit_id", "flow_id", "flow_status", "claim", "source_refs", "evidence"],
        "additionalProperties": true
      }
    },
    "attack_path": { "type": "array", "items": { "type": "object" } },
    "global_constraints": { "type": "object" },
    "evidence": { "type": "object" },
    "direct_security_impact": { "type": "object" },
    "cvss4_vector": { "type": "string" },
    "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
    "closure_facts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["fact_id", "statement", "evidence"],
        "additionalProperties": true
      }
    }
  }
}
