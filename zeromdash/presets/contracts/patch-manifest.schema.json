{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zeromdash.local/schemas/patch-manifest.schema.json",
  "title": "ZeroMDASH target-history patch manifest",
  "description": "Versioned, repository-qualified target vulnerability and patch history for both single-repository and multi-repository targets.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "target", "mode", "repositories", "coverage", "findings"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "target": {"type": "string", "minLength": 1},
    "mode": {"enum": ["single_repo", "multi_repo"]},
    "repositories": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/repository"}
    },
    "coverage": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/coverage"}
    },
    "findings": {
      "type": "array",
      "items": {"$ref": "#/$defs/finding"}
    }
  },
  "$defs": {
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repo_id", "role", "target", "repo_path", "branch", "head", "describe"],
      "properties": {
        "repo_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
        "role": {"type": "string"},
        "target": {"type": "string", "minLength": 1},
        "repo_path": {"type": "string", "minLength": 1},
        "branch": {"type": ["string", "null"]},
        "head": {"type": ["string", "null"]},
        "describe": {"type": ["string", "null"]}
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repo_id", "status", "sources_checked", "notes"],
      "properties": {
        "repo_id": {"type": "string", "minLength": 1},
        "status": {"enum": ["researched", "no_public_history", "unavailable"]},
        "sources_checked": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "notes": {"type": "string"}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "url"],
      "properties": {
        "type": {"enum": ["advisory", "writeup", "patch", "issue", "release_note", "other"]},
        "url": {"type": "string", "minLength": 1}
      }
    },
    "patch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "upstream_commits", "equivalent_commits", "verification", "verified_against_head", "fixed_versions", "notes"],
      "properties": {
        "status": {"enum": ["applied", "not_applied", "partial", "not_applicable", "unknown", "unavailable"]},
        "upstream_commits": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "equivalent_commits": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "verification": {"enum": ["ancestor", "content_equivalent", "absent", "not_checked", "not_in_git", "not_isolatable"]},
        "verified_against_head": {"type": ["string", "null"]},
        "fixed_versions": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "notes": {"type": "string"}
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_id", "repo_id", "advisory_ids", "title", "root_cause_class", "affected_locations", "sources", "applicability", "patch", "lesson", "notes"],
      "properties": {
        "record_id": {"type": "string", "minLength": 1},
        "repo_id": {"type": "string", "minLength": 1},
        "advisory_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "title": {"type": "string", "minLength": 1},
        "root_cause_class": {"type": "string", "minLength": 1},
        "affected_locations": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source"}},
        "applicability": {"enum": ["affected", "fixed", "unaffected", "historical_class", "unknown"]},
        "patch": {"$ref": "#/$defs/patch"},
        "lesson": {"type": "string", "minLength": 1},
        "notes": {"type": "string"}
      }
    }
  }
}
