{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "zeromdash://contracts/chain-finalizer.schema.json",
  "title": "Chain Finalizer Verdict",
  "description": "Final adjudication for a chain candidate whose deterministic structural gate failed after a confirming chain critic review.",
  "type": "object",
  "required": [
    "decision",
    "reasoning",
    "chain_is_valid",
    "deterministic_failures_are_contract_only",
    "all_primitives_confirmed",
    "bindings_valid",
    "global_constraints_satisfiable",
    "no_external_primitives_required",
    "direct_security_impact",
    "cvss4_vector",
    "confidence",
    "title",
    "detail",
    "evidence"
  ],
  "additionalProperties": true,
  "properties": {
    "decision": {
      "type": "string",
      "enum": ["accept", "reject"]
    },
    "reasoning": {
      "type": "string",
      "minLength": 1
    },
    "chain_is_valid": {
      "type": "boolean"
    },
    "deterministic_failures_are_contract_only": {
      "type": "boolean"
    },
    "all_primitives_confirmed": {
      "type": "boolean"
    },
    "bindings_valid": {
      "type": "boolean"
    },
    "global_constraints_satisfiable": {
      "type": "boolean"
    },
    "no_external_primitives_required": {
      "type": "boolean"
    },
    "direct_security_impact": {
      "type": "object",
      "required": ["vulnerable_system", "subsequent_system"],
      "additionalProperties": true,
      "properties": {
        "vulnerable_system": {
          "type": "object",
          "additionalProperties": true
        },
        "subsequent_system": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "cvss4_vector": {
      "type": "string",
      "minLength": 1
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "detail": {
      "type": "string",
      "minLength": 1
    },
    "violated_security_property": {
      "type": "string"
    },
    "evidence": {
      "type": "object",
      "additionalProperties": true
    },
    "scope_verdict": {
      "type": "string",
      "enum": ["introduced", "enabled", "regressed", "pre_existing", "unrelated", "unknown", "full_repository", ""]
    },
    "gate_decision": {
      "type": "string",
      "enum": ["block", "warn", "ignore", ""]
    },
    "accepted_failure_reasons": {
      "type": "array",
      "items": { "type": "string" }
    },
    "blocking_failure_reasons": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
