{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "zeromdash://contracts/gather-chain-review.schema.json",
  "title": "Gather chain review",
  "type": "object",
  "required": ["verdict", "reasoning", "all_units_confirmed", "bindings_valid", "global_constraints_satisfiable", "required_external_primitives", "closure_verdict", "edge_verdicts", "fact_verdicts", "direct_security_impact", "cvss4_vector", "confidence", "selected_skills"],
  "additionalProperties": true,
  "properties": {
    "verdict": { "enum": ["confirm", "reject", "revise"] },
    "reasoning": { "type": "string", "minLength": 1 },
    "all_units_confirmed": { "type": "boolean" },
    "bindings_valid": { "type": "boolean" },
    "global_constraints_satisfiable": { "type": "boolean" },
    "required_external_primitives": { "type": "array", "items": { "type": "string" } },
    "closure_verdict": { "enum": ["closed", "open"] },
    "edge_verdicts": {
      "type": "array",
      "items": { "type": "object", "required": ["edge_id", "verdict", "reasoning", "evidence"], "additionalProperties": true }
    },
    "fact_verdicts": {
      "type": "array",
      "items": { "type": "object", "required": ["fact_id", "classification", "blocking", "resolved", "reasoning", "evidence"], "additionalProperties": true }
    },
    "direct_security_impact": { "type": "object" },
    "cvss4_vector": { "type": "string" },
    "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
    "gate_decision": { "enum": ["block", "warn", "ignore", ""] },
    "selected_skills": { "type": "array", "items": { "type": "string" } },
    "feedback": { "type": "object" }
  }
}
