{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "zeromdash://contracts/cross-target-registry.schema.json",
  "title": "Cross-target attack-surface registry",
  "type": "object",
  "required": ["schema_version", "scenario", "targets", "interfaces", "data_flows", "cross_target_invariants", "deployment_assumptions", "unresolved_gaps"],
  "additionalProperties": true,
  "properties": {
    "schema_version": { "const": "1.0" },
    "scenario": { "type": "string", "minLength": 1 },
    "targets": { "type": "array", "items": { "type": "object" } },
    "interfaces": { "type": "array", "items": { "type": "object" } },
    "data_flows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["flow_id", "producer_target_id", "consumer_target_id", "data_object", "status", "source_refs"],
        "additionalProperties": true,
        "properties": {
          "flow_id": { "type": "string", "minLength": 1 },
          "producer_target_id": { "type": "string", "minLength": 1 },
          "consumer_target_id": { "type": "string", "minLength": 1 },
          "data_object": { "type": "string", "minLength": 1 },
          "status": { "enum": ["confirmed", "scenario_asserted", "hypothesized", "contradicted"] },
          "source_refs": { "type": "array", "items": { "type": "object" } }
        }
      }
    },
    "cross_target_invariants": { "type": "array", "items": { "type": "object" } },
    "deployment_assumptions": { "type": "array", "items": { "type": "object" } },
    "unresolved_gaps": { "type": "array" }
  }
}
