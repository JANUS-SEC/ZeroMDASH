{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "zeromdash://contracts/chain-investigation.schema.json",
  "title": "Chain Investigation",
  "description": "Per-iteration output of chain_investigate_subtask.",
  "type": "object",
  "required": [
    "title",
    "detail",
    "ordered_primitive_ids",
    "bindings",
    "binding_claims",
    "emergent_transitions",
    "evidence",
    "direct_security_impact",
    "blocking_unmet_facts",
    "validation_gaps",
    "deployment_constraints",
    "impact_limits"
  ],
  "additionalProperties": true,
  "properties": {
    "title": { "type": "string", "minLength": 1 },
    "detail": { "type": "string", "minLength": 1 },
    "ordered_primitive_ids": {
      "type": "array",
      "minItems": 2,
      "items": { "type": "string", "minLength": 1 }
    },
    "bindings": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "object" }
    },
    "binding_claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["edge_id", "claim", "evidence", "registry_refs"],
        "additionalProperties": true,
        "properties": {
          "edge_id": { "type": "string", "minLength": 1 },
          "claim": { "type": "string", "minLength": 1 },
          "evidence": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "registry_refs": { "type": "array", "items": { "type": "string" } },
          "deterministic_advisories": { "type": "array" }
        }
      }
    },
    "emergent_transitions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["transition_id", "combined_operation", "resulting_state", "evidence", "violated_invariant_ids"],
        "additionalProperties": true,
        "properties": {
          "transition_id": { "type": "string", "minLength": 1 },
          "combined_operation": { "type": "string", "minLength": 1 },
          "resulting_state": { "type": "string", "minLength": 1 },
          "violated_invariant_ids": { "type": "array", "items": { "type": "string" } },
          "evidence": { "type": "array", "minItems": 1, "items": { "type": "string" } }
        }
      }
    },
    "attack_path": {
      "type": "array",
      "items": { "type": "object" }
    },
    "evidence": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": true
    },
    "direct_security_impact": {
      "type": "object",
      "additionalProperties": true
    },
    "cvss4_vector": {
      "type": "string"
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "blocking_unmet_facts": { "$ref": "#/definitions/chainFacts" },
    "validation_gaps": { "$ref": "#/definitions/chainFacts" },
    "deployment_constraints": { "$ref": "#/definitions/chainFacts" },
    "impact_limits": { "$ref": "#/definitions/chainFacts" },
    "unmet_facts": {
      "type": "array",
      "description": "Deprecated compatibility alias for blocking_unmet_facts.",
      "items": { "type": "string" }
    },
    "counterevidence": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "definitions": {
    "chainFacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["fact_id", "statement", "evidence"],
        "additionalProperties": true,
        "properties": {
          "fact_id": { "type": "string", "minLength": 1 },
          "statement": { "type": "string", "minLength": 1 },
          "evidence": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
