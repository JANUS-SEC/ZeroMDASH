{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "zeromdash://contracts/report-group-adjudication.schema.json",
  "title": "Report Group Adjudication",
  "description": "Semantic merge decisions over deterministic vulnerability report groups.",
  "type": "object",
  "required": ["merge_groups"],
  "additionalProperties": true,
  "properties": {
    "merge_groups": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_group_ids", "reasoning"],
        "additionalProperties": true,
        "properties": {
          "source_group_ids": {
            "type": "array",
            "minItems": 2,
            "items": { "type": "string", "minLength": 1 }
          },
          "reasoning": {
            "type": "string",
            "minLength": 1
          },
          "root_cause": {
            "type": "string"
          },
          "shared_sink": {
            "type": "string"
          },
          "trigger_equivalence": {
            "type": "string"
          },
          "variant_notes": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "rejected_merges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "source_group_ids": {
            "type": "array",
            "items": { "type": "string" }
          },
          "reasoning": {
            "type": "string"
          }
        }
      }
    },
    "notes": {
      "type": "string"
    }
  }
}
