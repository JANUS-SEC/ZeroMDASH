{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "zeromdash://contracts/chain-plan.schema.json",
  "title": "Chain Plan",
  "description": "Agent-produced attack-chain candidates selected from the confirmed primitive pool.",
  "type": "object",
  "required": ["chains"],
  "additionalProperties": true,
  "properties": {
    "chains": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["ordered_primitive_ids", "bindings"],
        "additionalProperties": true,
        "properties": {
          "chain_id": { "type": "string" },
          "ordered_primitive_ids": {
            "type": "array",
            "minItems": 2,
            "items": { "type": "string", "minLength": 1 }
          },
          "attacker_entry": { "type": "object", "additionalProperties": true },
          "bindings": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["consumer_primitive_id", "required_capability", "provider", "compatibility_reason", "evidence"],
              "additionalProperties": true,
              "properties": {
                "consumer_primitive_id": { "type": "string", "minLength": 1 },
                "required_capability": { "type": "object", "additionalProperties": true },
                "provider": {
                  "type": "object",
                  "required": ["type", "capability"],
                  "additionalProperties": true,
                  "properties": {
                    "type": { "type": "string", "enum": ["primitive", "attacker_entry"] },
                    "primitive_id": { "type": "string" },
                    "capability": { "type": "object", "additionalProperties": true }
                  }
                },
                "compatibility_reason": { "type": "string", "minLength": 1 },
                "evidence": { "type": "array", "minItems": 1, "items": { "type": "string" } }
              }
            }
          },
          "global_constraints": { "type": "object", "additionalProperties": true },
          "expected_terminal_impact": {
            "type": "object",
            "description": "Advisory expected impact. May be empty when the chain battle must establish emergent impact.",
            "additionalProperties": true
          },
          "emergent_impact_hypothesis": { "type": "object", "additionalProperties": true },
          "rank_score": { "type": "number" },
          "status": { "type": "string" },
          "pruning_context": { "type": "object", "additionalProperties": true },
          "deterministic_advisories": { "type": "array" }
        }
      }
    }
  }
}
