{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "zeromdash://contracts/gather-chain-plan.schema.json",
  "title": "Gather chain plan",
  "type": "object",
  "required": ["chains"],
  "additionalProperties": true,
  "properties": {
    "chains": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["target_sequence", "ordered_unit_ids", "bindings", "rank_score", "agent_reasoning"],
        "additionalProperties": true,
        "properties": {
          "target_sequence": { "type": "array", "minItems": 2, "items": { "type": "string", "minLength": 1 } },
          "ordered_unit_ids": { "type": "array", "minItems": 2, "items": { "type": "string", "minLength": 1 } },
          "bindings": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["provider_unit_id", "consumer_unit_id", "flow_id", "compatibility_reason", "source_refs"],
              "additionalProperties": true
            }
          },
          "rank_score": { "type": "number" },
          "agent_reasoning": { "type": "string" }
        }
      }
    }
  }
}
