{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "zeromdash://contracts/gather-chain-finalizer.schema.json",
  "title": "Gather chain finalizer verdict",
  "type": "object",
  "required": ["decision", "reasoning", "chain_is_valid", "deterministic_failures_are_contract_only", "all_units_confirmed", "bindings_valid", "global_constraints_satisfiable", "no_external_primitives_required", "title", "detail", "direct_security_impact", "cvss4_vector", "confidence", "evidence", "accepted_failure_reasons", "blocking_failure_reasons"],
  "additionalProperties": true,
  "properties": {
    "decision": { "enum": ["accept", "reject"] },
    "reasoning": { "type": "string", "minLength": 1 },
    "chain_is_valid": { "type": "boolean" },
    "deterministic_failures_are_contract_only": { "type": "boolean" },
    "all_units_confirmed": { "type": "boolean" },
    "bindings_valid": { "type": "boolean" },
    "global_constraints_satisfiable": { "type": "boolean" },
    "no_external_primitives_required": { "type": "boolean" },
    "title": { "type": "string", "minLength": 1 },
    "detail": { "type": "string", "minLength": 1 },
    "direct_security_impact": { "type": "object" },
    "cvss4_vector": { "type": "string", "minLength": 1 },
    "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
    "evidence": { "type": "object" },
    "accepted_failure_reasons": { "type": "array", "items": { "type": "string" } },
    "blocking_failure_reasons": { "type": "array", "items": { "type": "string" } }
  }
}
