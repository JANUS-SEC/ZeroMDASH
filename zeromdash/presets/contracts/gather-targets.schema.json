{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "zeromdash://contracts/gather-targets.schema.json",
  "title": "Gather target manifest",
  "type": "object",
  "required": ["schema_version", "scenario", "targets"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "1.0" },
    "name": { "type": "string", "minLength": 1 },
    "scenario": { "type": "string", "minLength": 1 },
    "gather_agent_config": { "type": "string", "minLength": 1 },
    "targets": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["name", "agent_config", "workspace"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "agent_config": { "type": "string", "minLength": 1 },
          "workspace": { "type": "string", "minLength": 1 },
          "role": { "type": "string" }
        }
      }
    }
  }
}
