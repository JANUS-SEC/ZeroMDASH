{{
  "permissions": {{
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(*)",
      "Read(**)",
      "Write({workspace_base}/**)",
      "Edit({workspace_base}/**)",
      "WebFetch",
      "WebSearch"
    ],
    "deny": [
      {claude_repo_permission_denies}
    ],
    "additionalDirectories": [
      "{workspace_base}",
      "{main}",
      "{similar}",
      "{log}"
    ]
  }},
  "sandbox": {{
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "filesystem": {{
      "allowWrite": [
        "{workspace_base}"
      ],
      "allowRead": [
        "{workspace_base}"
      ],
      "denyWrite": [
        {claude_repo_sandbox_deny_write}
      ],
      "denyRead": [
        "~/.ssh",
        "~/.aws",
        "~/.gnupg",
        "~/.kube",
        "~/.config/gcloud",
        "~/.docker",
        "~/.npmrc",
        "~/.pypirc",
        "~/.netrc",
        "~/.bash_history",
        "~/.zsh_history",
        "~/.fish_history",
        "~/.python_history",
        "~/.config/git/credentials",
        "~/.git-credentials"
      ]
    }},
    "network": {{
      "allowedDomains": ["*"],
      "deniedDomains": []
    }}
  }},
  "env": {{
    "ZEROMDASH_NODE": "{node}",
    "ZEROMDASH_SUBTASK": "{subtask_id}",
    "ZEROMDASH_TARGET": "{target}",
    "ZEROMDASH_WORKSPACE": "{workspace_base}"
  }}
}}
